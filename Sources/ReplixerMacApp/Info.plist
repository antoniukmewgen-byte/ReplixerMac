<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Phase 8.3 — first real Info.plist this project has ever had. Two
         consumers, two different embedding paths, see Package.swift's
         linkerSettings comment and Scripts/build-app-bundle.sh:
         (1) embedded directly into the raw Xcode-debug executable via a
             `__TEXT,__info_plist` linker section — enough for LSUIElement
             and NSMicrophoneUsageDescription, which AppKit/TCC read straight
             off the running process's own Mach-O;
         (2) copied verbatim into Contents/Info.plist of the packaged
             ReplixerMac.app for a real bundle — needed for SMAppService
             (AutoStartManager) to register a login item at all, which
             the raw-executable-plus-linker-section form can't satisfy
             (SMAppServiceErrorDomain Code=1 "Operation not permitted" —
             confirmed on a real build). -->
    <key>CFBundleIdentifier</key>
    <string>com.replixer.ReplixerMac</string>
    <key>CFBundleName</key>
    <string>ReplixerMac</string>
    <key>CFBundleDisplayName</key>
    <string>ReplixerMac</string>
    <key>CFBundleExecutable</key>
    <string>ReplixerMacApp</string>
    <!-- TelegramUploadService.appVersion reads this back via
         Bundle.main.infoDictionary — keep the two in sync when bumping. -->
    <key>CFBundleShortVersionString</key>
    <string>0.2.3</string>
    <key>CFBundleVersion</key>
    <string>5</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- Phase 13.4 — app icon, ported straight from Windows' Assets/Icons/
         IconApp.png (the "RE" monogram) via Sources/ReplixerMacApp/
         AppIcon.icns (generated from that same 512×512 source — no higher-
         res/vector source exists on the Windows side to derive a cleaner
         1024 top size from). No `.xcassets`/asset catalog in this project
         (bare SwiftPM executable, not an Xcode app target), so this is the
         classic pre-asset-catalog mechanism: a loose `AppIcon.icns` dropped
         into Contents/Resources (see Scripts/build-app-bundle.sh) with
         CFBundleIconFile naming it by filename stem, no extension. Only
         takes effect for the real .app bundle that script produces — the
         raw Xcode-debug executable (this same Info.plist embedded via
         Package.swift's `__info_plist` linker section) has no
         Contents/Resources to find the icns in, so it keeps showing
         Xcode's generic tool icon while debugging; that's fine, matches
         how LSUIElement/TCC strings already only fully apply once
         bundled too. -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.2</string>
    <!-- Phase 8.3: menu-bar-only, no Dock icon/Cmd+Tab entry — Windows-tray
         parity (StatusItemController is the way back in). AppDelegate's
         explicit `NSApp.setActivationPolicy(.accessory)` mirrors this; if
         that line ever drifts back to `.regular` it silently overrides
         this key at runtime, so keep the two in sync. -->
    <key>LSUIElement</key>
    <true/>
    <!-- Required for AVAudioEngine.inputNode/AVAudioApplication's TCC
         prompt (Phase 1.2) to show at all instead of silently failing —
         previously relied on whatever default Xcode's throwaway
         SPM-executable wrapper synthesized. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>ReplixerMac потребує доступ до мікрофона, щоб записувати твою сторону розмови під час дзвінків.</string>
    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- Phase 9 — Sparkle auto-update. GitHub-Releases-hosted feed: this
         exact URL pattern (`/releases/latest/download/<asset>`) redirects to
         whatever asset named `appcast.xml` is attached to the most recent
         *published* (non-draft/non-prerelease) GitHub Release — no separate
         web server or gh-pages branch needed, matching Windows'
         raw.githubusercontent.com-manifest approach in spirit. Scripts/
         release.sh re-uploads an accumulating appcast.xml (one <item> per
         released version, newest first) to every new Release it creates. -->
    <key>SUFeedURL</key>
    <string>https://github.com/antoniukmewgen-byte/ReplixerMac/releases/latest/download/appcast.xml</string>
    <!-- REQUIRED before Sparkle will do anything but log an error — run
         `bin/generate_keys` from a downloaded Sparkle-X.Y.Z.tar.xz release
         (see Package.swift's Sparkle dependency comment) ONCE, on the Mac
         that will sign releases; it prints a public key and stores the
         matching private key in that Mac's login Keychain. Paste the
         printed public key here. Leaving this placeholder in place makes
         Sparkle refuse to install any update (by design — an unset/invalid
         SUPublicEDKey means "no one has proven any update is authentic
         yet"), so this is safe to ship as-is until the key exists. -->
    <key>SUPublicEDKey</key>
    <string>ked7JFQISRML+PIpm18Xrmeb5oBoQhovF//DPhD5N7M=</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <!-- Seconds between background checks — 86400 = once/day, Sparkle's own
         documented default; spelled out explicitly rather than left
         implicit so a future "перевіряти щотижня"-style Settings toggle has
         an obvious existing key to read/write instead of guessing. -->
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
</dict>
</plist>
