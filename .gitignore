# Swift Package Manager build artifacts
.build/
.swiftpm/
DerivedData/

# Xcode
xcuserdata/
*.xcodeproj/
*.xcworkspace/

# macOS
.DS_Store

# --- Secrets / local config -------------------------------------------
# Real runtime config lives outside the repo (~/Library/Application
# Support/ReplixerMac/{settings.json,recordings.json}), so these
# shouldn't normally appear here at all — this is a safety net in case
# someone copies a real settings.json or a Google service-account key
# into the project folder for convenience while testing.
settings.json
recordings.json
*.pem
*.p12
*service-account*.json
*service_account*.json
*serviceaccount*.json

# Build-time secrets baked into the binary — Windows-parity
# AppSecrets.cs/AppSecrets.example.cs pattern (see AppSecrets.example.swift
# for the tracked template). Real values never get committed.
Sources/ReplixerMacCore/GoogleDrive/AppSecrets.swift
